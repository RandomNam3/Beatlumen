# Settings for compose.yml: copy to .env and adjust.
# (The password goes into password.txt and the pepper into pepper.bin, not
# here.)

# Host folders with music and background images (mounted read-only).
MUSIC_DIR=/srv/music
IMAGES_DIR=/srv/backgrounds

# Port on the host. Use a reverse proxy with HTTPS for access from the
# internet, or a VPN.
BEATLUMEN_PORT=7878

# Name shown in the apps.
BEATLUMEN_NAME=Beatlumen Server

# Host names of a reverse proxy (comma separated); IP addresses, localhost
# and *.local/*.lan/*.home.arpa/*.internal always work.
BEATLUMEN_ALLOWED_HOSTS=

# Seconds between library rescans (0 = off).
BEATLUMEN_RESCAN_INTERVAL=600

# Longest track (minutes) analysed on the server (0 = unlimited).
BEATLUMEN_ANALYSIS_MAX_MINUTES=20

# Encrypted storage per account in MiB (0 = unlimited).
BEATLUMEN_VAULT_QUOTA_MB=10240

# Log every request.
BEATLUMEN_VERBOSE=false
