# Settings for compose.yml: copy to .env and adjust.
# (The password goes into password.txt and the pepper into pepper.bin, not
# here.)

# Host folders with music and background images (mounted read-only).
MUSIC_DIR=/srv/music
IMAGES_DIR=/srv/backgrounds

# Port on the host. Use a reverse proxy with HTTPS for access from the
# internet, or a VPN.
BEATLUMEN_PORT=7878

# Everything below is optional: set in the admin interface (/admin/) when
# left empty. A value set here is fixed and read-only there.

# Name shown in the apps.
BEATLUMEN_NAME=

# Host names of a reverse proxy (comma separated); IP addresses, localhost
# and *.local/*.lan/*.home.arpa/*.internal always work.
BEATLUMEN_ALLOWED_HOSTS=

# Seconds between library rescans (0 = off; default 600).
BEATLUMEN_RESCAN_INTERVAL=

# Longest track (minutes) analysed on the server (0 = unlimited; default 20).
BEATLUMEN_ANALYSIS_MAX_MINUTES=

# Encrypted storage per account in MiB (0 = unlimited; default 10240).
BEATLUMEN_VAULT_QUOTA_MB=

# New accounts: "invite" (with an invitation code) or "off"; default invite.
BEATLUMEN_REGISTRATION=

# Log every request (true/false).
BEATLUMEN_VERBOSE=
