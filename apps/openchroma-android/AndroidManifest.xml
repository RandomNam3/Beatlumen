<?xml version="1.0" encoding="utf-8"?>
<!-- Beatlumen for Android. SPDX-License-Identifier: GPL-3.0-or-later
     versionCode/versionName/min/target SDK are passed by build-android.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.randomnam3.beatlumen">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Only for the user-configured Beatlumen server (plain HTTP on the LAN). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local music library and background images. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:label="Beatlumen"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:appCategory="audio"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:windowSoftInputMode="stateHidden|adjustNothing"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale|mcc|mnc|touchscreen|colorMode">
            <meta-data android:name="android.app.lib_name" android:value="beatlumen" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
