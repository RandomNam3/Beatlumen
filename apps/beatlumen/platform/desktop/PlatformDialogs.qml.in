import QtQuick
import QtQuick.Dialogs
import Beatlumen.Core

// File and folder pickers on desktop platforms: the system's dialogs
// (Qt Quick Dialogs; on Linux through the XDG desktop portal) or, where
// there are none, the app's own picker (Qt's generic replacement dialog
// would not follow the app's design and language).
Item {
    id: dialogs
    signal musicFolderChosen(string path)
    signal imageFolderChosen(string path)

    readonly property var audioExts: ["mp3", "flac", "ogg", "oga", "opus", "m4a", "mp4", "aac", "wav", "aif", "aiff", "mka", "webm", "mp2", "hfx"]
    readonly property var imageExts: ["jpg", "jpeg", "png", "webp", "gif", "bmp"]

    function openAudio() {
        if (Core.nativeDialogs) audioDialog.open()
        else pick("files", audioExts, "music_note", Theme.tr("Open files"), (p) => Core.call("open", { paths: p, play: true }))
    }
    function openImages() {
        if (Core.nativeDialogs) imageDialog.open()
        else pick("files", imageExts, "image", Theme.tr("Add images"), (p) => Core.call("backgrounds.add", { sources: p, show: true }))
    }
    function openUpload() {
        if (Core.nativeDialogs) uploadDialog.open()
        else pick("files", ["*"], "upload", Theme.tr("Upload files"), (p) => Core.call("vault.upload", { paths: p }))
    }
    function openLyrics() {
        if (Core.nativeDialogs) lyricsDialog.open()
        else pick("file", ["lrc", "txt"], "lyrics", Theme.tr("Add song text…"), (p) => Core.call("lyrics.importFile", { path: p[0] }))
    }
    function addMusicFolder() {
        if (Core.nativeDialogs) folderDialog.open()
        else pick("folder", [], "folder", Theme.tr("Add music folder"), (p) => Core.call("library.addFolder", { path: p[0] }))
    }
    function addImageFolder() {
        if (Core.nativeDialogs) imageFolderDialog.open()
        else pick("folder", [], "folder", Theme.tr("Add folder"), (p) => Core.call("backgrounds.addFolder", { path: p[0] }))
    }

    property var onPicked: null
    function pick(mode, exts, icon, title, done) {
        picker.mode = mode
        picker.extensions = exts
        picker.fileIcon = icon
        picker.title = title
        onPicked = done
        picker.show()
    }
    FilePicker {
        id: picker
        onPicked: (paths) => { if (dialogs.onPicked) dialogs.onPicked(paths) }
    }

    FolderDialog {
        id: folderDialog
        title: Theme.tr("Add music folder")
        onAccepted: {
            const p = Core.localPaths([selectedFolder])
            if (p.length > 0)
                Core.call("library.addFolder", { path: p[0] })
        }
    }
    FolderDialog {
        id: imageFolderDialog
        title: Theme.tr("Add folder")
        onAccepted: {
            const p = Core.localPaths([selectedFolder])
            if (p.length > 0)
                Core.call("backgrounds.addFolder", { path: p[0] })
        }
    }
    FileDialog {
        id: audioDialog
        title: Theme.tr("Open files")
        fileMode: FileDialog.OpenFiles
        nameFilters: ["Audio (*.mp3 *.flac *.ogg *.oga *.opus *.m4a *.mp4 *.aac *.wav *.aif *.aiff *.mka *.webm *.mp2)", "Styles (*.hfx)", "* (*)"]
        onAccepted: Core.openUrls(selectedFiles)
    }
    FileDialog {
        id: uploadDialog
        title: Theme.tr("Upload files")
        fileMode: FileDialog.OpenFiles
        nameFilters: ["Audio (*.mp3 *.flac *.ogg *.oga *.opus *.m4a *.mp4 *.aac *.wav *.aif *.aiff *.mka *.webm *.mp2)", "* (*)"]
        onAccepted: Core.call("vault.upload", { paths: Core.localPaths(selectedFiles) })
    }
    FileDialog {
        id: lyricsDialog
        title: Theme.tr("Add song text…")
        nameFilters: [Theme.tr("Song texts") + " (*.lrc *.txt)", "* (*)"]
        onAccepted: {
            const p = Core.localPaths([selectedFile])
            if (p.length > 0)
                Core.call("lyrics.importFile", { path: p[0] })
        }
    }
    FileDialog {
        id: imageDialog
        title: Theme.tr("Add images")
        fileMode: FileDialog.OpenFiles
        nameFilters: ["Images (*.jpg *.jpeg *.png *.webp *.gif *.bmp)"]
        onAccepted: {
            const paths = Core.localPaths(selectedFiles)
            Core.call("backgrounds.add", { sources: paths, show: true })
        }
    }
}
