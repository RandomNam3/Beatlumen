<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15+: keep the classic layout where the window stops at the
         system bars and adjustResize shrinks it for the keyboard. Qt's
         normal (non-expanded) window mode relies on that; the remaining
         safe-area insets (cutouts) are applied by ApplicationWindow's padding. -->
    <style name="BeatlumenTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
